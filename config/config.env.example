# STRK Engine · Configuration
# ============================
# Copy this file to config.env and fill in your values.
# NEVER commit config.env to git (it's in .gitignore).

# === REQUIRED · Blockchain APIs ===
ETHERSCAN_API_KEY=your_etherscan_key_here
STARKSCAN_API_KEY=your_starkscan_key_here

# === REQUIRED · Telegram Alerts ===
# Create bot: message @BotFather in Telegram, /newbot
# Get chat_id: message @userinfobot, it will reply with your ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# === OPTIONAL · Discord Alert Reader ===
# Only needed if you want to read Nansen/other Discord alert channels.
# See docs/DISCORD_SETUP.md for step-by-step how to create bot.
# Leave blank to skip Discord module.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=1502225814714978374

# === Safety flag · always keep true ===
STRICT_NO_TRADING=true
