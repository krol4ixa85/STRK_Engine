# Secrets - NEVER commit
config/config.env
*.env
.env

# Logs
logs/
*.log

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node — 9.6 МБ, лежали untracked. Один `git add -A` удвоил бы репозиторий.
node_modules/
package-lock.json

# Backups (не пушить)
data/seeds/backups/
*.bak
*.bak_*

# Cache CSV — regenerated each run, не нужны для бэктеста
data/cache/*.csv

# ============================================================
# ВАЖНО: data/cache/*.json теперь ВСЕ commit'ятся
# Это нужно для:
#   1. Squeeze detector (нужен свежий funding_signal, cohort_tracker)
#   2. Backtest historical (нужны snapshots detector outputs)
#   3. Отладка (видеть последнее состояние каждого модуля)
#
# Ранее *.json был в ignore + whitelist на 5 state files.
# Проблема: wyckoff/technical/confluence/squeeze не сохранялись.
# ============================================================
# (никакого data/cache/*.json ignore здесь нет — коммитим всё)

# data/reports/ — HTML отчёты, allow полностью
# data/history/*.jsonl — критично для бэктеста, allow
# data/seeds/ — критично, allow

# ============================================================
# Coin Metrics Community · выгрузка длинной истории
#
# Две причины не коммитить:
#
# 1. ЛИЦЕНЗИЯ. Данные под CC BY-NC 4.0 — некоммерческая.
#    Использовать для собственных решений можно. Выкладывать саму
#    выгрузку в публичный репозиторий — вопрос к их лицензии,
#    который стоит уточнить у Coin Metrics прежде чем это делать.
#
# 2. ВЕС. 16 700 дней по шести активам, и это только начало —
#    в списке 33 актива. Репозиторий и так растёт примерно на
#    мегабайт в сутки от коммитов ботов.
#
# Данные восстанавливаются одной командой, хранить их в git незачем:
#   python3 scripts/collectors/coinmetrics_history.py
# ============================================================
data/history/coinmetrics/

# Свечи Hyperliquid: 198 000 баров по 41 токену, ~40 МБ. Тоже
# восстанавливаются одной командой:
#   python3 scripts/collectors/hl_history.py --interval 4h
data/history/hl/
data/history/hl_4h/
data/history/hl_funding/

# Разовые выгрузки Dune в корне — по 600 КБ каждая, на них никто
# не ссылается. Четыре штуки уже лежат в истории (1.8 МБ).
dune_data_*.json

# Бинарники: дельта-сжатие git на них не работает, каждая версия
# ложится целиком
*.parquet
