# Cloudflare Pages Cache Rules · STRK LAB Dashboard v3
# Combined with URL versioning system for bulletproof cache control
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# VERSION.txt: NEVER cache (this is the key file that busts everything else)
/VERSION.txt
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# Root path (index.html): NEVER cache
/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# All HTML files: NEVER cache
/*.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# JSON data files with ?v= param: 5-min cache (safe because URL changes on deploy)
/data/cache/*.json
  Cache-Control: public, max-age=300, must-revalidate

# Token scan JSONs
/data/cache/token_scan/*.json
  Cache-Control: public, max-age=300, must-revalidate

# History JSONL files
/data/history/*.jsonl
  Cache-Control: public, max-age=600

# CSS files with ?v= param: 1-hour cache
/*.css
  Cache-Control: public, max-age=3600

# JS files with ?v= param: 1-hour cache
/*.js
  Cache-Control: public, max-age=3600
