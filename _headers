# Cloudflare Pages Cache Rules · STRK LAB Dashboard v2
# ORDER MATTERS: More specific rules FIRST, catch-all LAST
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Root path (index.html): NEVER cache
/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# All HTML files: NEVER cache
/*.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# JSON data files: 30-second cache
/data/cache/*.json
  Cache-Control: public, max-age=30, must-revalidate

# Sub-folder JSONs
/data/cache/token_scan/*.json
  Cache-Control: public, max-age=60, must-revalidate

# History JSONL files: 5-min cache
/data/history/*.jsonl
  Cache-Control: public, max-age=300

# CSS files: 1-hour cache
/*.css
  Cache-Control: public, max-age=3600

# JS files: 1-hour cache
/*.js
  Cache-Control: public, max-age=3600

# NOTE: catch-all `/*` REMOVED to prevent conflict with HTML rules
# Default Cloudflare Pages behavior for other files: no explicit cache
